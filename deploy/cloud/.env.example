# Copy to deploy/cloud/.env. Never commit real values.
CLOUD_DOMAIN=app.example.com
# Use a long random hex password; avoid URL-reserved characters in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_random_hex
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me
SITE_IMAGE_TAG=local
API_IMAGE_TAG=local
# Exact origins for Trend only. Add the actual local port if different.
TREND_ALLOWED_ORIGINS=https://marvel-l.github.io,http://localhost:3000,http://localhost:3001
