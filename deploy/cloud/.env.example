# Copy to deploy/cloud/.env. Never commit real values.
CLOUD_DOMAIN=app.example.com
# Use a long random hex password; avoid URL-reserved characters in DATABASE_URL.
POSTGRES_PASSWORD=replace_with_random_hex
GITHUB_CLIENT_ID=replace_me
GITHUB_CLIENT_SECRET=replace_me
SITE_IMAGE_TAG=local
API_IMAGE_TAG=local
# Exact origins for Trend and Monthly Planner cross-origin sync. Add the actual local port if different.
TREND_ALLOWED_ORIGINS=https://marvel-l.github.io,http://localhost:3000,http://localhost:3001
# Optional GitHub Contents API writer for cloud planner changes. Use a fine-grained token scoped to this repository's contents.
PLANNER_GITHUB_TOKEN=
PLANNER_GITHUB_OWNER=Marvel-L
PLANNER_GITHUB_REPO=Blog
PLANNER_GITHUB_BRANCH=custom
PLANNER_GITHUB_PATH=planner-data
