{
  "name": "d-blog",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "compress:images": "node scripts/compress-content-images.mjs",
    "gen:data": "node scripts/generate-site-data.mjs",
    "build:ssr": "npm run build:ssr --workspace @d-blog/blog --",
    "ssg": "node scripts/ssg.mjs",
    "audit:build": "node scripts/audit-build.mjs",
    "audit:seo": "node scripts/seo-audit.mjs",
    "check:links": "node scripts/check-broken-links.mjs",
    "typecheck": "npm run typecheck:blog && npm run typecheck --workspace @d-blog/server",
    "check": "npm run gen:data && npm run typecheck",
    "dev": "npm run dev --workspace @d-blog/blog --",
    "build": "npm run build --workspace @d-blog/blog --",
    "build:verbose": "npm run build --workspace @d-blog/blog -- --verbose",
    "preview": "npm run preview --workspace @d-blog/blog --",
    "test": "npm run test:blog && npm run test:server",
    "test:watch": "vitest",
    "test:coverage": "npm run gen:data && vitest run --coverage && npm run test:server",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "typecheck:blog": "npm run typecheck --workspace @d-blog/blog --",
    "build:cloud": "npm run build:cloud --workspace @d-blog/blog --",
    "dev:server": "npm run dev --workspace @d-blog/server",
    "test:server": "npm test --workspace @d-blog/server",
    "test:blog": "npm run gen:data && vitest run",
    "dev:cloud": "npm run dev:cloud --workspace @d-blog/blog --",
    "test:frontend": "npm test --workspace @d-blog/blog --",
    "build:pages": "npm run build --workspace @d-blog/blog --"
  },
  "dependencies": {
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "undici": "^8.10.0",
    "@d-blog/blog": "*"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.18",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.4.35",
    "prettier": "^3.9.6",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "unified": "^11.0.5",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --fix",
    "*.{ts,tsx,js,mjs,json,md,css}": "prettier --write"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "pixi-live2d-display": {
      "gh-pages": "^6.3.0"
    }
  },
  "workspaces": [
    "packages/*"
  ]
}
