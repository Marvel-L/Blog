{
  "name": "@d-blog/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  }
}
